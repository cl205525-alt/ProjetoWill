{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "outDir": "dist/renderer/ts",
    "rootDir": "src/renderer/ts",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": [
